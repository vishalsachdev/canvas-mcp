# Canvas API Configuration (Required)
CANVAS_API_TOKEN=your_canvas_api_token_here
CANVAS_API_URL=https://your-institution.instructure.com/api/v1

# Canvas OAuth refresh (optional; the client secret and refresh token stay on
# the server). CANVAS_BASE_URL is the Canvas origin, without /api/v1.
CANVAS_BASE_URL=https://your-institution.instructure.com
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REFRESH_TOKEN=
# Set this only when the original Canvas OAuth authorization used redirect_uri.
CANVAS_OAUTH_REDIRECT_URI=

# Optional Configuration
MCP_SERVER_NAME=canvas-api
DEBUG=false
API_TIMEOUT=30
CACHE_TTL=300
MAX_CONCURRENT_REQUESTS=10

# Development Configuration
LOG_LEVEL=INFO
LOG_API_REQUESTS=false

# Privacy and Security Configuration
ENABLE_DATA_ANONYMIZATION=true
ANONYMIZATION_DEBUG=false
LOG_REDACT_PII=true

# Audit Logging (Optional, disabled by default)
LOG_ACCESS_EVENTS=false
LOG_EXECUTION_EVENTS=false
AUDIT_LOG_DIR=

# Code Execution Sandbox (secure defaults, override to disable)
ENABLE_TS_SANDBOX=true
TS_SANDBOX_MODE=auto
TS_SANDBOX_BLOCK_OUTBOUND_NETWORK=true
TS_SANDBOX_ALLOWLIST_HOSTS=
# TS_SANDBOX_CPU_LIMIT is CPU seconds (best-effort locally, ulimit in container).
TS_SANDBOX_CPU_LIMIT=30
TS_SANDBOX_MEMORY_LIMIT_MB=512
TS_SANDBOX_TIMEOUT_SEC=120
TS_SANDBOX_CONTAINER_IMAGE=node:20-alpine

# Public HTTP MCP authentication (required for a public ChatGPT connection).
# FastMCP acts as an OAuth 2.1 proxy in front of the upstream OIDC provider.
# Register https://your-mcp.example.com/auth/callback at that provider.
MCP_AUTH_MODE=none
MCP_PUBLIC_URL=https://your-mcp.example.com
MCP_OIDC_CONFIG_URL=https://your-idp.example.com/.well-known/openid-configuration
MCP_OIDC_CLIENT_ID=
MCP_OIDC_CLIENT_SECRET=
# Generate a separate high-entropy value; do not reuse the IdP client secret.
MCP_OIDC_JWT_SIGNING_KEY=
# Comma-separated; permits ChatGPT's stable and callback-specific redirects.
MCP_OIDC_ALLOWED_CLIENT_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect,https://chatgpt.com/connector/oauth/*
# Optional upstream audience, token-endpoint auth method, and required scopes.
MCP_OIDC_AUDIENCE=
MCP_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
MCP_OIDC_REQUIRED_SCOPES=
MCP_OIDC_REDIRECT_PATH=/auth/callback
MCP_OIDC_REQUIRE_AUTHORIZATION_CONSENT=true

# Optional Metadata
INSTITUTION_NAME=Your Institution Name
TIMEZONE=UTC
