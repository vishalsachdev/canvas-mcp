{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/github_session_brief.py\"",
            "timeout": 45,
            "statusMessage": "Checking GitHub issues, PRs and discussions"
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(gh api:*)",
      "Bash(python -c:*)",
      "mcp__canvas-api__execute_typescript",
      "Bash(curl:*)",
      "Bash(bash -c:*)",
      "Bash(codex:*)",
      "Bash(chmod:*)",
      "Bash(git push:*)",
      "Bash(gh release:*)",
      "Bash(git tag:*)",
      "Bash(az webapp *)",
      "Bash(npx wrangler *)",
      "Bash(gh label:*)",
      "Bash(gh workflow:*)",
      "Bash(gh repo:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh gist:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh project:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh cache:*)",
      "Bash(gh discussion:*)",
      "mcp__canvas__execute_typescript",
      "mcp__canvas-mcp__execute_typescript",
      "mcp__canvas_api__execute_typescript"
    ]
  }
}
