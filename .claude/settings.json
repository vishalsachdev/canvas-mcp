{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/github_session_brief.py\"",
            "timeout": 45,
            "statusMessage": "Checking GitHub issues, PRs and discussions"
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(gh api:*)",
      "Bash(python -c:*)",
      "mcp__canvas-api__execute_typescript",
      "Bash(curl:*)",
      "Bash(bash -c:*)",
      "Bash(codex:*)",
      "Bash(chmod:*)",
      "Bash(git push:*)",
      "Bash(gh release:*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr close:*)",
      "Bash(git tag:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(az webapp *)",
      "Bash(npx wrangler *)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh issue transfer:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh label:*)",
      "Bash(gh workflow:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh run cancel:*)",
      "Bash(gh repo:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh gist:*)"
    ]
  }
}
