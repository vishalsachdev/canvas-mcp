# Sample: auto-deploy every push to main (i.e. every merged PR) — builds the
# container image, pushes it to your Azure Container Registry, and deploys it
# to the Production slot. No manual gate: a merge to main IS the deploy trigger.
#
# To use: copy to .github/workflows/deploy-prod.yml and replace <registry-name>
# and <app-name>. Requires repo secrets ACR_USERNAME / ACR_PASSWORD (or switch
# the login step to a service principal) and AZURE_WEBAPP_PUBLISH_PROFILE_PROD.
# SCM basic auth must be enabled on the app or azure/webapps-deploy fails with
# "Failed to get app runtime OS" (see README §7.2).
name: Deploy to Azure — production

on:
  push:
    branches: [main]
    paths-ignore:
      - 'docs/**'
      - '**.md'
      - 'tools/**'
  workflow_dispatch: {}

concurrency:
  group: deploy-prod
  cancel-in-progress: false

env:
  REGISTRY: <registry-name>.azurecr.io
  IMAGE: canvas-mcp
  APP_NAME: <app-name>

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Compute image tag
        id: tag
        run: echo "tag=$(git rev-parse --short HEAD)" >> "$GITHUB_OUTPUT"

      - name: Log in to ACR
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ secrets.ACR_USERNAME }}
          password: ${{ secrets.ACR_PASSWORD }}

      - name: Build and push image
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: ${{ env.REGISTRY }}/${{ env.IMAGE }}:${{ steps.tag.outputs.tag }}

      - name: Deploy to production slot
        uses: azure/webapps-deploy@v3
        with:
          app-name: ${{ env.APP_NAME }}
          slot-name: Production
          publish-profile: ${{ secrets.AZURE_WEBAPP_PUBLISH_PROFILE_PROD }}
          images: ${{ env.REGISTRY }}/${{ env.IMAGE }}:${{ steps.tag.outputs.tag }}
